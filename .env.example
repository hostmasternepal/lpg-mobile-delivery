# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=lpg_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lpg_delivery
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lpg_app:change_me@postgres:5432/lpg_delivery?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend (NestJS) ---
BACKEND_PORT=3001
NODE_ENV=development

# JWT (ARCH-DECISION-05) — generate real secrets for anything beyond local dev
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_TTL=7d

# OTP HMAC key (ARCH-DECISION-10) — server-held, never exposed to clients
OTP_HMAC_SECRET=dev_otp_hmac_secret_change_me

# SMS gateway — provider is OPEN-BUSINESS-DECISION-31; placeholder only
SMS_PROVIDER=noop
SMS_PROVIDER_API_KEY=

# CORS — restrict to the deployed frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
